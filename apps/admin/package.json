    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
